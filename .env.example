# Copy to .env (the bootstrap does this for you). Never commit .env.
# --- ERCOT Public API (OPTIONAL: unlocks forecast/outage history; everything else works without) ---
# Sign up at https://apiexplorer.ercot.com (US IP required), then fill these in:
ERCOT_API_USERNAME=
ERCOT_API_PASSWORD=
ERCOT_API_SUBSCRIPTION_KEY=
# Ticket 01 appends the service settings below this line.
# --- Service settings (all have working defaults; override only if needed) ---
POSTGRES_DSN=postgresql://gridtwin:gridtwin@localhost:5432/gridtwin
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_PORT=8000
# Comma-separated list of origins the API's CORS policy allows.
CORS_ORIGINS=http://localhost:3000
WORKER_REPLICAS=2
SIMULATOR_REPLICAS=2
HEARTBEAT_INTERVAL_SECONDS=1
HEARTBEAT_STALE_SECONDS=5
# Base URL the dashboard (web/) uses to reach the API. No hardcoded host in web code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Ticket 02 appends the dispatch settings below this line.
TASK_QUEUE=gridtwin-dispatch
# ERCOT settlement point the replay dispatches against; see docs/SPEC.md Defaults.
SETTLEMENT_POINT=LZ_HOUSTON
# One real(*) post-RTC+B day of 15-min RT settlement point prices. (*) see docs/DECISIONS.md ADR-007.
FIXTURE_PATH=data/fixtures/rtm_spp_lz_houston_2025-12-10.csv
# Wall seconds per Market Interval = 900 / REPLAY_SPEED (60x -> 15s per interval).
REPLAY_SPEED=60
DEVICE_COUNT=10
DEVICE_ENERGY_KWH=39.2
DEVICE_MAX_POWER_KW=10.0
DEVICE_ROUND_TRIP_EFFICIENCY=0.9
RESERVE_FLOOR_PCT=0.20
INITIAL_SOC_PCT=0.50
# Naive strategy: discharge at/above this price, charge at/below this price, else idle.
NAIVE_DISCHARGE_THRESHOLD_USD=90.0
NAIVE_CHARGE_THRESHOLD_USD=20.0
DISPATCH_TIMEOUT_SECONDS=5.0
